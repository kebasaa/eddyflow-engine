# gitignore for EddyFlow engine
# created by gerardo fratini for Fortran/C::B

### FORTRAN ###
*.exe
*.mod
*.o

### MAC ###
*.DS_Store
*.db

### MISC ###
*.bak

### EP ###
*.eddypro

### DIRS AND SPECIFIC FILES###
bin
mod
obj
backup_EddyFlow_to_dropbox.bat
ep_engine_devtools.py
src/src_common/deprecated
src/src_common/under_development
src/src_fcc/deprecated
src/src_rp/deprecated
/example-data
/_docs
/tests
# The FLUXNET regression harness and its fixtures, but not the run output.
# base_rec staying byte-identical is the proof that a per-gas conversion was
# faithful, so the fixtures are part of the format's definition; leaving them
# out is why the harness had to be rebuilt from scratch more than once.
!/tests/
/tests/*
!/tests/regression/
/tests/regression/*
!/tests/regression/README.md
!/tests/regression/run.sh
!/tests/regression/base*.eddyflow
/_temp
/static_checks
!/static_checks/
/static_checks/*
!/static_checks/test_irga_path_classification_static.py
!/static_checks/test_fcc_full_header_static.py
!/static_checks/test_pwb_timelag_static.py
!/static_checks/test_spectral_assessment_diagnostics_static.py
!/static_checks/test_ini_tag_collisions_static.py
# These two pin the positional ex-file layout. They were untracked, which is
# how they went stale against two landed conversions - and were pytest-style,
# which is how `unittest discover` reported zero from them - without anything
# reporting either.
!/static_checks/test_ex_record_layout_static.py
!/static_checks/test_fluxnet_header_guard_static.py
/data/__pycache__
/data_test

# gfortran's fallback output; see the note in the GUI repo's .gitignore.
fort.*
